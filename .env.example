# --- POSTGRES CONFIG ---
POSTGRES_USER=cvboosta_admin
POSTGRES_PASSWORD=generate_a_strong_password_here
POSTGRES_DB=cvboosta_db

# --- BACKEND CONFIG ---
# Used for local dev (outside Docker): 
# DATABASE_URL=postgresql+psycopg://cvboosta_admin:password@localhost:5432/cvboosta_db
# In Docker, the URL is constructed automatically in docker-compose.yml

# Security
JWT_SECRET=run_openssl_rand_hex_32_and_paste_here
CORS_ORIGINS=http://localhost,https://your-production-domain.com

# LLM Config
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- FRONTEND CONFIG ---
# For Docker Nginx setup, this should be /api
NEXT_PUBLIC_API_BASE=/api

# Paddle (Client-side checkout)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your_paddle_client_side_token
NEXT_PUBLIC_PADDLE_PRICE_SINGLE_SCAN=pri_xxx_single_scan
NEXT_PUBLIC_PADDLE_PRICE_GO_WEEKLY=pri_xxx_go_weekly
NEXT_PUBLIC_PADDLE_PRICE_GO_MONTHLY=pri_xxx_go_monthly
NEXT_PUBLIC_PADDLE_PRICE_PRO_WEEKLY=pri_xxx_pro_weekly
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=pri_xxx_pro_monthly
NEXT_PUBLIC_PADDLE_PRICE_LIFETIME=pri_xxx_lifetime

# Paddle (Backend webhook verification and tier mapping)
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret
PADDLE_PRICE_SINGLE_SCAN=pri_xxx_single_scan
PADDLE_PRICE_GO_WEEKLY=pri_xxx_go_weekly
PADDLE_PRICE_GO_MONTHLY=pri_xxx_go_monthly
PADDLE_PRICE_PRO_WEEKLY=pri_xxx_pro_weekly
PADDLE_PRICE_PRO_MONTHLY=pri_xxx_pro_monthly
PADDLE_PRICE_LIFETIME=pri_xxx_lifetime

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRODUCT_ID=prod_ULbLPYmVv7U0QA
STRIPE_PRICE_SINGLE_SCAN=price_1TMu9DDeLDWD5SJ5B3IDVCoN
