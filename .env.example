# --- POSTGRES CONFIG ---
POSTGRES_USER=cvboosta_admin
POSTGRES_PASSWORD=generate_a_strong_password_here
POSTGRES_DB=cvboosta_db

# --- BACKEND CONFIG ---
# Used for local dev (outside Docker): 
# DATABASE_URL=postgresql+psycopg://cvboosta_admin:password@localhost:5432/cvboosta_db
# In Docker, the URL is constructed automatically in docker-compose.yml

# Security
JWT_SECRET=run_openssl_rand_hex_32_and_paste_here
CORS_ORIGINS=http://localhost,https://your-production-domain.com

# LLM Config
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- FRONTEND CONFIG ---
# For Docker Nginx setup, this should be /api
NEXT_PUBLIC_API_BASE=/api
